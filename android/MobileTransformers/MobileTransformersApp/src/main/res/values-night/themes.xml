<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The dark counterpart. See values/themes.xml for why this layer exists at all. -->
    <style name="Theme.MobileTransformersApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary_dark</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/brand_primary_dark</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">@color/brand_surface_container_dark</item>
        <item name="android:navigationBarColor">@color/brand_surface_container_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@color/brand_surface_dark</item>
    </style>
</resources>
