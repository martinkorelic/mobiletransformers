<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The window theme, which only governs what is drawn BEFORE and AROUND Compose: the cold-start
      window and the system bars. Everything inside the app is themed by `ui/theme/Theme.kt`.

      The status bar colour is also set at runtime from the live Compose scheme, because there are
      four schemes and one XML value cannot be right for all of them. This is the pre-composition
      value, keyed to FRI light so the launch does not flash a different colour.
    -->
    <style name="Theme.MobileTransformersApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Matches `TopAppBar`, which paints itself from `surfaceContainer`, so the status bar and
             the app bar read as one surface rather than as a seam. -->
        <item name="android:statusBarColor">@color/brand_surface_container</item>
        <item name="android:navigationBarColor">@color/brand_surface_container</item>
        <!-- A light bar needs dark icons, or the clock and battery vanish into it. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/brand_surface</item>
    </style>
</resources>
